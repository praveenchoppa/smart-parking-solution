# Copy to .env and set your local PostgreSQL credentials.
# Do not commit .env — it is listed in .gitignore.

# PostgreSQL Connection
DB_URL=jdbc:postgresql://localhost:5432/smart_parking
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# ⚠️ SECURITY WARNING: JWT signing secret MUST be overridden with a secure random string (at least 32 chars)
# before shared demo, deployment, or production submission. Do not use the default fallback in production.
JWT_SECRET=replace_with_a_long_random_dev_secret_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# AI-1 Python occupancy service (Flask @ port 5000)
AI1_BASE_URL=http://localhost:5000
AI1_TIMEOUT_MS=5000
# Toggles automatic creation of demo parking area 1 ("City Mall Main Lot", 69 slots A01-A69) at startup if area 1 is missing
AI1_DEMO_BOOTSTRAP_ENABLED=true
# Toggles Spring @Scheduled background polling to fetch AI-1 occupancy and merge with PostgreSQL DB every 10 seconds
AI1_SCHEDULED_SYNC_ENABLED=true
AI1_SCHEDULED_SYNC_INTERVAL_MS=15000

# AI-2 Python recommendation service (Flask @ port 5001)
AI2_BASE_URL=http://localhost:5001
AI2_TIMEOUT_MS=5000

# AI-3 Python prediction service (Flask @ port 5002)
AI3_BASE_URL=http://localhost:5002
AI3_TIMEOUT_MS=5000
