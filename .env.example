# Copy to .env and set your local PostgreSQL credentials.
# Do not commit .env — it is listed in .gitignore.

DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT signing secret (use a long random string in local .env; do not commit real secrets)
JWT_SECRET=replace_with_a_long_random_dev_secret_at_least_32_chars

# AI-1 Python occupancy service (Flask)
AI1_BASE_URL=http://localhost:5000
AI1_TIMEOUT_MS=5000

# AI-2 Python recommendation service (Flask)
AI2_BASE_URL=http://localhost:5001
AI2_TIMEOUT_MS=5000
